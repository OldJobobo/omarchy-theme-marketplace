<%# Canonical, Open Graph and Twitter tags, rendered into content_for :head. The image is the given
    theme's preview, or the catalog's cover theme (the first featured one) on pages about no theme. %>
<% preview = local_assigns[:theme] || catalog.cover %>
<link rel="canonical" href="<%= url %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Omarchy Themes">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= url %>">
<% if preview&.image %>
  <meta property="og:image" content="<%= preview.image %>">
  <meta property="og:image:width" content="<%= preview.preview["width"] %>">
  <meta property="og:image:height" content="<%= preview.preview["height"] %>">
<% end %>
<meta name="twitter:card" content="summary_large_image">
